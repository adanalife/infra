{
  "title": "15 — Radio",
  "uid": "radio",
  "schemaVersion": 39,
  "tags": [
    "radio",
    "audio"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Env",
        "type": "custom",
        "query": "prod-1,stage-1",
        "current": {
          "text": "prod-1",
          "value": "prod-1"
        },
        "options": [
          {
            "text": "prod-1",
            "value": "prod-1",
            "selected": true
          },
          {
            "text": "stage-1",
            "value": "stage-1",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Stations 📻",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "On air",
      "description": "1 while the station has something to air, so its Icecast mount is up. A station with an empty library is off air on purpose.",
      "datasource": {
        "type": "prometheus",
        "uid": "__DS_PROMETHEUS__"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (station) (liquidsoap_station_ready{namespace=\"$namespace\"})",
          "legendFormat": "{{station}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Off air",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "On air",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Listeners now",
      "description": "Icecast listeners on each mount: every platform's OBS, the TV app, the console, and tripbot's watchdog probe while it is probing.",
      "datasource": {
        "type": "prometheus",
        "uid": "__DS_PROMETHEUS__"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (station) (liquidsoap_station_listeners{namespace=\"$namespace\"})",
          "legendFormat": "{{station}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Library",
      "description": "Tracks the station's last rescan matched (every minute). A drop to 0 takes the mount down.",
      "datasource": {
        "type": "prometheus",
        "uid": "__DS_PROMETHEUS__"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (station) (liquidsoap_station_tracks{namespace=\"$namespace\"})",
          "legendFormat": "{{station}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "Trends",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Listeners",
      "description": "Icecast listeners per station over time.",
      "datasource": {
        "type": "prometheus",
        "uid": "__DS_PROMETHEUS__"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (station) (liquidsoap_station_listeners{namespace=\"$namespace\"})",
          "legendFormat": "{{station}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Loudness gain per track",
      "description": "The gain normalize_track_gain applied to each track to bring it to -16 LUFS. Positive: a quiet master turned up. Negative: a loud one turned down. A track that couldn't be measured keeps the previous value.",
      "datasource": {
        "type": "prometheus",
        "uid": "__DS_PROMETHEUS__"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (station) (liquidsoap_track_gain_db{namespace=\"$namespace\"})",
          "legendFormat": "{{station}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dB",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tracks played per hour",
      "description": "Tracks each station started airing over the last hour. A flat zero on an on-air station means it is stuck on one track.",
      "datasource": {
        "type": "prometheus",
        "uid": "__DS_PROMETHEUS__"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (station) (increase(liquidsoap_tracks_played_total{namespace=\"$namespace\"}[1h]))",
          "legendFormat": "{{station}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Stream's bed: on the radio or the fallback",
      "description": "tripbot's audio watchdog per platform: on fallback = 1 while the stream plays a local bed because the radio read as down (silence for ~21s or an unreachable station). Each swap either way counts.",
      "datasource": {
        "type": "prometheus",
        "uid": "__DS_PROMETHEUS__"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (service_platform) (obs_background_audio_on_fallback{service_name=\"tripbot\", deployment_environment=\"$namespace\"})",
          "legendFormat": "on fallback [{{service_platform}}]"
        },
        {
          "refId": "B",
          "expr": "sum by (service_platform) (increase(obs_background_audio_swaps_total{service_name=\"tripbot\", deployment_environment=\"$namespace\"}[1h]))",
          "legendFormat": "swaps/h [{{service_platform}}]"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
