{
  "title": "10 — Postgres Pool",
  "uid": "postgres-pool",
  "tags": ["tripbot", "postgres", "database"],
  "schemaVersion": 39,
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "deployment_environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "__DS_PROMETHEUS__"
        },
        "query": "label_values(target_info{job=\"tripbot/tripbot\"}, deployment_environment)",
        "current": {
          "text": "prod-1",
          "value": "prod-1"
        },
        "includeAll": true,
        "multi": false,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Open connections",
      "datasource": { "type": "prometheus", "uid": "__DS_PROMETHEUS__" },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "refId": "A", "expr": "sum by (deployment_environment) (db_sql_connection_open{service_name=\"tripbot\", deployment_environment=~\"$deployment_environment\"})", "legendFormat": "[{{deployment_environment}}]" }
      ],
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Max open",
      "datasource": { "type": "prometheus", "uid": "__DS_PROMETHEUS__" },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "refId": "A", "expr": "max by (deployment_environment) (db_sql_connection_max_open{service_name=\"tripbot\", deployment_environment=~\"$deployment_environment\"})", "legendFormat": "[{{deployment_environment}}]" }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Connection waits / 5m",
      "datasource": { "type": "prometheus", "uid": "__DS_PROMETHEUS__" },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "refId": "A", "expr": "sum by (deployment_environment) (increase(db_sql_connection_wait_total{service_name=\"tripbot\", deployment_environment=~\"$deployment_environment\"}[5m]))", "legendFormat": "[{{deployment_environment}}]" }
      ],
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 50 }
          ]}
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Query errors / 5m",
      "datasource": { "type": "prometheus", "uid": "__DS_PROMETHEUS__" },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "refId": "A", "expr": "sum by (deployment_environment) (increase(db_client_operation_duration_seconds_count{service_name=\"tripbot\", error_type!=\"\", deployment_environment=~\"$deployment_environment\"}[5m]))", "legendFormat": "[{{deployment_environment}}]" }
      ],
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 10 }
          ]}
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Connection pool by status",
      "datasource": { "type": "prometheus", "uid": "__DS_PROMETHEUS__" },
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "db_sql_connection_open{service_name=\"tripbot\", deployment_environment=~\"$deployment_environment\"}", "legendFormat": "{{status}} [{{deployment_environment}}]" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 30, "stacking": { "mode": "normal" } } }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Wait duration",
      "datasource": { "type": "prometheus", "uid": "__DS_PROMETHEUS__" },
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "sum by (deployment_environment) (rate(db_sql_connection_wait_duration_milliseconds_total{service_name=\"tripbot\", deployment_environment=~\"$deployment_environment\"}[5m]))", "legendFormat": "avg wait ms/s [{{deployment_environment}}]" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Query latency p95 by operation",
      "datasource": { "type": "prometheus", "uid": "__DS_PROMETHEUS__" },
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 9 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, db_operation_name, deployment_environment) (rate(db_client_operation_duration_seconds_bucket{service_name=\"tripbot\", error_type=\"\", deployment_environment=~\"$deployment_environment\"}[5m])))", "legendFormat": "{{db_operation_name}} [{{deployment_environment}}]" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 5 } }, "overrides": [] }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Query rate by operation (ok vs error)",
      "datasource": { "type": "prometheus", "uid": "__DS_PROMETHEUS__" },
      "gridPos": { "x": 0, "y": 21, "w": 24, "h": 9 },
      "targets": [
        { "refId": "A", "expr": "sum by (db_operation_name, error_type, deployment_environment) (rate(db_client_operation_duration_seconds_count{service_name=\"tripbot\", deployment_environment=~\"$deployment_environment\"}[5m]))", "legendFormat": "{{db_operation_name}} / {{error_type}} [{{deployment_environment}}]" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "stacking": { "mode": "normal" } } }, "overrides": [] }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Server — CNPG exporter (pg-1)",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 30, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Backends by state",
      "datasource": { "type": "prometheus", "uid": "__DS_PROMETHEUS__" },
      "gridPos": { "x": 0, "y": 31, "w": 12, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "sum by (namespace, state) (cnpg_backends_total{namespace=~\"$deployment_environment-data\", datname=\"tripbot\"})", "legendFormat": "{{state}} [{{namespace}}]" },
        { "refId": "B", "expr": "sum by (namespace) (cnpg_backends_waiting_total{namespace=~\"$deployment_environment-data\"})", "legendFormat": "waiting on a lock [{{namespace}}]" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Longest open transaction",
      "datasource": { "type": "prometheus", "uid": "__DS_PROMETHEUS__" },
      "gridPos": { "x": 12, "y": 31, "w": 12, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "max by (namespace) (cnpg_backends_max_tx_duration_seconds{namespace=~\"$deployment_environment-data\", datname=\"tripbot\"})", "legendFormat": "{{namespace}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Transactions / s (commit vs rollback)",
      "datasource": { "type": "prometheus", "uid": "__DS_PROMETHEUS__" },
      "gridPos": { "x": 0, "y": 39, "w": 8, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "sum by (namespace) (rate(cnpg_pg_stat_database_xact_commit{namespace=~\"$deployment_environment-data\", datname=\"tripbot\"}[5m]))", "legendFormat": "commit [{{namespace}}]" },
        { "refId": "B", "expr": "sum by (namespace) (rate(cnpg_pg_stat_database_xact_rollback{namespace=~\"$deployment_environment-data\", datname=\"tripbot\"}[5m]))", "legendFormat": "rollback [{{namespace}}]" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Buffer cache hit ratio",
      "datasource": { "type": "prometheus", "uid": "__DS_PROMETHEUS__" },
      "gridPos": { "x": 8, "y": 39, "w": 8, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "sum by (namespace) (rate(cnpg_pg_stat_database_blks_hit{namespace=~\"$deployment_environment-data\", datname=\"tripbot\"}[5m])) / (sum by (namespace) (rate(cnpg_pg_stat_database_blks_hit{namespace=~\"$deployment_environment-data\", datname=\"tripbot\"}[5m])) + sum by (namespace) (rate(cnpg_pg_stat_database_blks_read{namespace=~\"$deployment_environment-data\", datname=\"tripbot\"}[5m])))", "legendFormat": "{{namespace}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Database size",
      "datasource": { "type": "prometheus", "uid": "__DS_PROMETHEUS__" },
      "gridPos": { "x": 16, "y": 39, "w": 8, "h": 8 },
      "targets": [
        { "refId": "A", "expr": "sum by (namespace) (cnpg_pg_database_size_bytes{namespace=~\"$deployment_environment-data\", datname=\"tripbot\"})", "legendFormat": "{{namespace}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 } }, "overrides": [] }
    }
  ]
}
